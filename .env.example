# ============================================================
# Local development configuration template.
# Copy to `.env` and fill in locally — .env is gitignored and
# must NEVER be committed (HLD §1.4 / §5.4).
#
# Production sources of truth are SSM SecureStrings (HLD §2.6):
#   /pr-reviewer/github-token      (ingress/worker via scoped IAM)
#   /pr-reviewer/webhook-secret    (ingress only)
#   /pr-reviewer/glm-api-key       (worker only)
#   /pr-reviewer/glm-model         (plain String)
# ============================================================

AWS_REGION=us-west-2

# SSM parameter prefix used for credential hydration (HLD §2.3.1)
PR_REVIEWER_SSM_PREFIX=/pr-reviewer

# ---- Local-only secrets (leave empty unless testing locally) ----
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GLM_API_KEY=

# Model is configuration, never hard-coded (HLD §7.2)
GLM_MODEL=glm-5.3-flash

# Pinned GitHub REST API version (HLD §2.3.2)
GITHUB_API_VERSION=2026-03-10

LOG_LEVEL=INFO
