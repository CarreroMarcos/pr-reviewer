# ============================================================
# serverless-pr-reviewer — tailored gitignore
# Stack: Python 3.12 (stdlib + boto3, uv) · Terraform (AWS)
# Rule #1 (HLD §1.4): secrets never touch Terraform state, logs,
# or version control. Anything secret-shaped stays out of git.
# ============================================================

# ---- Secrets & environment (never commit; .env.example IS committed) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.tfvars        # may contain sensitive values
!*.tfvars.example
secrets/

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
*.tfplan.*
# NOTE: .terraform.lock.hcl is intentionally NOT ignored — lock files must be committed.

# ---- Lambda build artifacts (Terraform archive_file / manual zips) ----
*.zip
dist/
build/
out/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- AWS tooling ----
.aws-sam/
samconfig.toml

# ---- Tooling caches ----
.cache/
.pip-cache/

# ---- Local workspace dirs ----
.agents/
.opencode/
opencode.json
opencode.jsonc
temp/
.slim/
.slim/deepwork/

# ---- Editors / OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
